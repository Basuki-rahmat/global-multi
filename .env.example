NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=multi_global
DB_USER=root
DB_PASSWORD=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cadangan: dipakai otomatis jika Groq gagal / rate limit
# OPENAI_API_KEYS = daftar key dipisah koma, server rotasi otomatis saat 401/403/429/5xx
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

JWT_SECRET=replace-with-a-long-random-secret

# Email (SMTP hosting cPanel/sPanel) untuk email transaksi aplikasi
# Contoh cPanel: MAIL_HOST=mail.domainanda.com
# Port 465 = SSL langsung, port 587 = STARTTLS
#
# MAIL_USER adalah mailbox BISU khusus pengirim (mis. noreply@) dan WAJIB tidak
# punya Penjawab Otomatis, karena email registrasi/lupa-password akan dibalas
# balik oleh auto-responder dan membingungkan penerima.
# Satu mailbox pengirim melayani semua email; tidak perlu email per fitur.
# MAIL_REPLY_TO menunjuk mailbox manusia yang menerima balas-jawab pengguna.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=noreply@domainanda.com
MAIL_PASS=password-akun-noreply
MAIL_FROM=noreply@domainanda.com
MAIL_FROM_NAME=Multi Global
MAIL_REPLY_TO=admin@domainanda.com

# Domain publik aplikasi; dipakai untuk tautan reset password.
# Kosongkan pada localhost agar memakai CLIENT_URL.
APP_URL=
PASSWORD_RESET_TTL_MINUTES=60
